#!/usr/bin/env python3
"""Terminal wind scraper for windguru.cz: live station + GFS forecast.

Row 1: current wind at each spot (windguru weather stations).
Then per spot: today's remaining hours, then 4 day summaries.
"""
import json, os, pathlib, select, sys, tempfile, termios, time, tty
import urllib.request, datetime as dt

SPOTS = [
    # label, id_spot, id_station (None = forecast only)
    ("Bat Galim", 885332, 2049),
    ("Caesarea",  910318, 2259),
    ("Tel Aviv", 1084913, 3169),
    ("Ashdod",   1118129, 3444),
]
DEFAULT = ["Bat Galim", "Caesarea"]  # shown when no spot is named
ALERT_KT = 15          # --alert fires at or above this (avg or gust)
ALERT_COOLDOWN = 3 * 3600  # ...and then stays quiet this long for that spot
TZ = dt.timezone(dt.timedelta(hours=3))  # ponytail: Israel is UTC+3 in summer,
# UTC+2 in winter. Swap for zoneinfo("Asia/Jerusalem") if you run this in January.
GFS = 3
DAY_START, DAY_END = 8, 19  # local hours counted in a day summary
UA = {"User-Agent": "Mozilla/5.0", "Referer": "https://www.windguru.cz/"}

C = {"dim": "\033[2m", "grn": "\033[32m", "yel": "\033[33m", "red": "\033[31m",
     "mag": "\033[35m", "bold": "\033[1m", "off": "\033[0m"}


def get(**params):
    url = "https://www.windguru.cz/int/iapi.php?" + "&".join(f"{k}={v}" for k, v in params.items())
    with urllib.request.urlopen(urllib.request.Request(url, headers=UA), timeout=15) as r:
        return json.load(r)


def compass(deg):
    pts = "N NE E SE S SW W NW".split()
    return pts[int((deg % 360) / 45 + 0.5) % 8]


def arrow(deg):
    # points where the wind blows TO (deg is where it comes FROM)
    return "↓↙←↖↑↗→↘"[int((deg % 360) / 45 + 0.5) % 8]


def paint(kt):
    if kt is None:
        return "dim"
    if kt < 8:
        return "dim"
    if kt < 15:
        return "grn"
    if kt < 23:
        return "yel"
    if kt < 32:
        return "red"
    return "mag"


def col(s, key):
    return f"{C[key]}{s}{C['off']}"


FCST_TTL = 900  # ponytail: GFS publishes every 6h; 15 min is plenty fresh and
# keeps `watch -n 30 wind` from hammering windguru for data that has not moved.


def station(id_station):
    return get(q="station_data_current", id_station=id_station) if id_station else {}


def forecast(id_spot):
    cache = pathlib.Path(tempfile.gettempdir()) / f"wind-fcst-{id_spot}.json"
    if cache.exists() and time.time() - cache.stat().st_mtime < FCST_TTL:
        return decode(json.loads(cache.read_text()))
    meta = get(q="forecast_spot", id_spot=id_spot)
    tab = meta["tabs"][0]
    m = next(x for x in tab["id_model_arr"] if x["id_model"] == GFS)
    f = get(q="forecast", id_model=GFS, id_spot=id_spot, initstr=m["initstr"],
            rundef=m["rundef"].split("-")[0], cachefix=m["cachefix"],
            WINDSPD=1, GUST=1, SMER=1)["fcst"]
    cache.write_text(json.dumps(f))
    return decode(f)


def decode(f):
    base = dt.datetime.fromtimestamp(f["initstamp"], TZ)
    return [{"t": base + dt.timedelta(hours=h), "spd": f["WINDSPD"][i],
             "gust": f["GUST"][i], "dir": f["WINDDIR"][i]}
            for i, h in enumerate(f["hours"])]


def day_summary(rows, day):
    d = [r for r in rows if r["t"].date() == day and DAY_START <= r["t"].hour <= DAY_END]
    if not d:
        return None
    peak = max(d, key=lambda r: r["gust"])
    return {"lo": min(r["spd"] for r in d), "hi": max(r["spd"] for r in d),
            "gust": peak["gust"], "dir": peak["dir"]}


def render(spots):
    width = 4
    lw = max(len(label) for label, _, _ in spots)
    out = [""]
    for label, id_spot, id_station in spots:
        s = station(id_station)
        if s.get("wind_avg") is None:
            out.append(f"  {C['bold']}{label:<{lw}}{C['off']} {col('no live data', 'dim')}")
            continue
        avg, gust = s["wind_avg"], s["wind_max"]
        out.append(f"  {C['bold']}{label:<{lw}}{C['off']} "
                   f"{col(f'{avg:>5.1f} kt', paint(avg))} "
                   f"{col(f'g{gust:.1f}', paint(gust)):<12} "
                   f"{arrow(s['wind_direction'])} {compass(s['wind_direction'])}"
                   f"{s['wind_direction']:>4}°  {s['temperature']:.0f}°C"
                   f"  {col(s['datetime'][11:16], 'dim')}")

    now = dt.datetime.now(TZ)
    for label, id_spot, _ in spots:
        rows = forecast(id_spot)
        today = [r for r in rows if r["t"].date() == now.date() and r["t"].hour >= now.hour]
        out.append(f"\n  {C['bold']}{label}{C['off']}  {col('today', 'dim')}")
        out.append("   " + "".join(f"{r['t'].hour:>{width}}" for r in today))
        out.append("   " + "".join(col(f"{r['spd']:>{width}.0f}", paint(r["spd"])) for r in today))
        out.append("   " + col("".join(f"{r['gust']:>{width}.0f}" for r in today), "dim"))
        out.append("   " + "".join(f"{arrow(r['dir']):>{width}}" for r in today))

        parts = []
        for n in range(1, 5):
            day = now.date() + dt.timedelta(days=n)
            d = day_summary(rows, day)
            if not d:
                continue
            parts.append(f"{day.strftime('%a')} "
                         + col(f"{d['lo']:.0f}-{d['hi']:.0f}", paint(d["hi"]))
                         + col(f"g{d['gust']:.0f}", "dim")
                         + f" {compass(d['dir'])}")
        out.append("   " + "  ".join(parts))
    return "\n".join(out) + "\n"


USAGE = f"""usage: wind [SPOT...] [-a] [--watch [SECONDS]] [--alert [KT]]

  SPOT      any part of the name, case-insensitive; repeat to pick several.
            known: {', '.join(label for label, _, _ in SPOTS)}
  -a/--all  every spot, not just the default {' + '.join(DEFAULT)}.
  --watch   repaint every SECONDS (default 30); q, Esc or Ctrl-C quits.
  --alert   check once and Telegram any spot at or above KT (default {ALERT_KT:g});
            prints what it sent and exits. Built for cron.

  wind                      {' and '.join(DEFAULT)}, print once
  wind -a                   all spots
  wind tel --watch 15       Tel Aviv, live
  wind -a --alert 18        ping Telegram if anywhere is over 18 kt
"""


def pick(names, show_all=False):
    """Filter SPOTS by case-insensitive substring. No names -> DEFAULT, or all."""
    if not names:
        return list(SPOTS) if show_all else [s for s in SPOTS if s[0] in DEFAULT]
    out = [s for s in SPOTS if any(n.lower() in s[0].lower() for n in names)]
    if not out:
        raise SystemExit(f"no spot matches {' '.join(names)}\n\n{USAGE}")
    return out


def tg_config():
    """Bot token and chat id from the environment, or ~/.config/wind/telegram.env."""
    env = dict(os.environ)
    cfg = (pathlib.Path(os.environ.get("XDG_CONFIG_HOME", pathlib.Path.home() / ".config"))
           / "wind" / "telegram.env")
    if cfg.exists():
        for line in cfg.read_text().splitlines():
            line = line.strip()
            if line and not line.startswith("#") and "=" in line:
                k, v = line.split("=", 1)
                env.setdefault(k.strip(), v.strip().strip("\"'"))
    token, chat = env.get("WIND_TG_TOKEN"), env.get("WIND_TG_CHAT")
    if not token or not chat:
        raise SystemExit(
            f"set WIND_TG_TOKEN and WIND_TG_CHAT, or put them in {cfg}\n"
            "  WIND_TG_TOKEN=123456:AA...   (from @BotFather)\n"
            "  WIND_TG_CHAT=@windchannel    (or the numeric -100... id)")
    return token, chat


def telegram(text):
    token, chat = tg_config()
    body = json.dumps({"chat_id": chat, "text": text}).encode()
    req = urllib.request.Request(f"https://api.telegram.org/bot{token}/sendMessage",
                                 data=body, headers={"Content-Type": "application/json"})
    with urllib.request.urlopen(req, timeout=15) as r:
        return json.load(r)


def should_alert(state, label, kt, now, threshold, cooldown):
    """True on a rising edge, or once per cooldown while still blowing.

    `state` maps label -> last alert time; mutated in place. Dropping below the
    threshold clears it, so the next gust alerts immediately.
    """
    if kt < threshold:
        state.pop(label, None)
        return False
    last = state.get(label)
    if last is not None and now - last < cooldown:
        return False
    state[label] = now
    return True


def alert(spots, threshold):
    cache = pathlib.Path(os.environ.get("XDG_CACHE_HOME", pathlib.Path.home() / ".cache"))
    cache.mkdir(parents=True, exist_ok=True)
    statef = cache / "wind-alerts.json"
    state = json.loads(statef.read_text()) if statef.exists() else {}
    now = time.time()
    sent = []
    for label, _, id_station in spots:
        s = station(id_station)
        if s.get("wind_avg") is None:
            continue
        kt = max(s["wind_avg"], s["wind_max"])
        if should_alert(state, label, kt, now, threshold, ALERT_COOLDOWN):
            d = s["wind_direction"]
            telegram(f"\U0001F32C {label}: {s['wind_avg']:.1f} kt, gusting "
                     f"{s['wind_max']:.1f} \u00b7 {compass(d)} {d}\u00b0 \u00b7 "
                     f"{s['temperature']:.0f}\u00b0C \u00b7 {s['datetime'][11:16]}")
            sent.append(label)
    statef.write_text(json.dumps(state))
    print(f"alerted: {', '.join(sent)}" if sent else f"nothing at or above {threshold:g} kt")


def watch(spots, interval):
    """Repaint every `interval` seconds until q (or Ctrl-C)."""
    fd = sys.stdin.fileno()
    if not os.isatty(fd):  # ponytail: piped or in a cron job, no keys to read
        while True:
            print(render(spots), flush=True)
            time.sleep(interval)
    saved = termios.tcgetattr(fd)
    try:
        tty.setcbreak(fd)
        sys.stdout.write("\033[?25l")
        while True:
            frame = render(spots)  # fetch first, so the screen is only blank while painting
            clock = dt.datetime.now(TZ).strftime("%H:%M:%S")
            sys.stdout.write("\033[H\033[2J" + frame
                             + col(f"   {clock} · every {interval:g}s · q to quit\n", "dim"))
            sys.stdout.flush()
            if select.select([sys.stdin], [], [], interval)[0]:
                if sys.stdin.read(1) in ("q", "Q", "\x03", "\x1b"):
                    return
    except KeyboardInterrupt:
        return
    finally:
        termios.tcsetattr(fd, termios.TCSADRAIN, saved)
        sys.stdout.write("\033[?25h")
        sys.stdout.flush()


def main(argv):
    if {"-h", "--help"} & set(argv):
        print(USAGE, end="")
        return
    threshold = None
    if "--alert" in argv:
        i = argv.index("--alert")
        argv.pop(i)
        threshold = ALERT_KT
        if i < len(argv) and argv[i].replace(".", "", 1).isdigit():
            threshold = float(argv.pop(i))
    interval = None
    if "--watch" in argv:
        i = argv.index("--watch")
        argv.pop(i)
        interval = 30
        if i < len(argv) and argv[i].replace(".", "", 1).isdigit():
            interval = float(argv.pop(i))
    show_all = bool({"-a", "--all"} & set(argv))
    spots = pick([a for a in argv if not a.startswith("-")], show_all)
    if threshold is not None:
        alert(spots, threshold)
    elif interval:
        watch(spots, interval)
    else:
        print(render(spots), end="")


def selftest():
    assert compass(0) == "N" and compass(189) == "S" and compass(350) == "N"
    assert compass(45) == "NE" and compass(280) == "W"
    assert arrow(0) == "↓" and arrow(180) == "↑"
    assert paint(5) == "dim" and paint(10) == "grn" and paint(20) == "yel"
    assert paint(25) == "red" and paint(40) == "mag" and paint(None) == "dim"
    t = dt.datetime(2026, 8, 30, tzinfo=TZ)
    rows = [{"t": t + dt.timedelta(hours=h), "spd": h, "gust": h * 2, "dir": 180}
            for h in range(24)]
    d = day_summary(rows, t.date())
    assert (d["lo"], d["hi"], d["gust"]) == (8, 19, 38), d
    assert day_summary(rows, t.date() + dt.timedelta(days=3)) is None
    f = {"initstamp": int(t.timestamp()), "hours": [0, 1],
         "WINDSPD": [5, 6], "GUST": [9, 10], "WINDDIR": [180, 190]}
    got = decode(f)
    assert got[0]["t"] == t and got[1]["spd"] == 6 and got[1]["dir"] == 190, got
    assert [x[0] for x in pick([])] == DEFAULT
    assert pick([], show_all=True) == list(SPOTS)
    assert [x[0] for x in pick(["bat", "cae"])] == ["Bat Galim", "Caesarea"]
    assert [x[0] for x in pick(["ASHDOD"])] == ["Ashdod"]
    assert [x[0] for x in pick(["a"])] == [s[0] for s in SPOTS]  # substring, not prefix
    try:
        pick(["nope"])
    except SystemExit:
        pass
    else:
        raise AssertionError("pick should exit on no match")
    st, now = {}, 1000.0
    assert should_alert(st, "X", 20, now, 15, 3600) is True      # rising edge
    assert should_alert(st, "X", 20, now + 60, 15, 3600) is False  # still blowing
    assert should_alert(st, "X", 20, now + 4000, 15, 3600) is True  # cooldown passed
    assert should_alert(st, "X", 9, now + 4100, 15, 3600) is False and st == {}
    assert should_alert(st, "X", 20, now + 4200, 15, 3600) is True  # dropped, re-arms
    print("ok")


if __name__ == "__main__":
    selftest() if "--selftest" in sys.argv else main(sys.argv[1:])
